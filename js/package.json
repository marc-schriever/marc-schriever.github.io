{
  "name": "marc-schriever-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio-Website Marc Schriever, statisch, ohne Build-Step",
  "scripts": {
    "test": "vitest run --environment jsdom",
    "test:watch": "vitest --environment jsdom",
    "test:coverage": "vitest run --environment jsdom --coverage --coverage.reporter=text --coverage.reporter=lcov"
  },
  "devDependencies": {
    "vitest": "^3.0.0",
    "jsdom": "^25.0.0",
    "@vitest/coverage-v8": "^3.0.0"
  }
}


